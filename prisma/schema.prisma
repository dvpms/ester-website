// prisma/schema.prisma
// Prisma Schema untuk Esther Property CMS (Neon Serverless Postgres)

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// ── 1. NextAuth.js v5 Models ──────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  role          String    @default("admin")
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ── 2. Kawasan (Hub SEO) ──────────────────────────────────────
model Kawasan {
  id                 String    @id // slug unik (misal: "bsd-city")
  slug               String    @unique
  nama               String
  namaEn             String    @map("nama_en")
  deskripsi          String    @db.Text
  deskripsiEn        String    @db.Text @map("deskripsi_en")
  fotoHero           String    @map("foto_hero")
  fasilitasUnggulan   Json      @map("fasilitas_unggulan") // array of strings
  fasilitasUnggulanEn Json      @map("fasilitas_unggulan_en") // array of strings
  lat                Float?
  lng                Float?
  listings           Listing[]
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("kawasan")
}

// ── 3. Listing Properti ───────────────────────────────────────
model Listing {
  id             String   @id @default(cuid())
  slug           String   @unique
  nama           String
  namaEn         String   @map("nama_en")
  judulBrosur    String?  @map("judul_brosur")
  segmen         String   // primary | secondary
  jenisProperti  String   @map("jenis_properti") // rumah | ruko | kavling | apartemen
  transaksi      String   // dijual | disewakan
  kawasanId      String   @map("kawasan_id")
  kawasan        Kawasan  @relation(fields: [kawasanId], references: [id], onDelete: Restrict)
  kawasanSlug    String   @map("kawasan_slug")
  harga          BigInt   // Angka harga Rupiah
  lokasiDetail   String   @map("lokasi_detail")
  spesifikasi    Json     // { lt, lb, kamarTidur, kamarMandi, lantai, hadap, listrik, air, sertifikat }
  fiturUnggulan  Json     @map("fitur_unggulan") // array of strings
  bonusInterior  Json?    @map("bonus_interior") // array of strings
  lat            Float?
  lng            Float?
  tautanMaps     String?  @map("tautan_maps")
  
  // Manajemen Foto & Brosur
  gambarUtama    String   @map("gambar_utama") // URL foto utama / cover listing
  galeri         Json     // array of strings (semua foto galeri)
  fotoBrosur     Json?    @map("foto_brosur") // array of strings (foto terpilih khusus brosur)
  brosurUrl      String?  @map("brosur_url") // Cloudinary HD brochure URL
  
  status         String   @default("tersedia") // tersedia | terjual | proses
  developerNama  String?  @map("developer_nama")
  pemilikNama    String?  @map("pemilik_nama")
  deskripsi      String   @db.Text
  deskripsiEn    String   @db.Text @map("deskripsi_en")
  featured       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("listings")
}

// ── 4. Artikel Blog ───────────────────────────────────────────
model Artikel {
  id             String   @id @default(cuid())
  slug           String   @unique
  judul          String
  judulEn        String   @map("judul_en")
  ringkasan      String   @db.Text
  ringkasanEn    String   @db.Text @map("ringkasan_en")
  konten         String   @db.Text
  kontenEn       String   @db.Text @map("konten_en")
  thumbnail      String
  tagKawasan     Json     @map("tag_kawasan") // array of kawasan slugs
  tags           Json     // array of SEO keywords
  isPublished    Boolean  @default(true) @map("is_published")
  tanggalPublish DateTime @default(now()) @map("tanggal_publish")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("artikel")
}

// ── 5. Testimoni Klien ────────────────────────────────────────
model Testimoni {
  id          String   @id @default(cuid())
  namaKlien   String   @map("nama_klien")
  fotoKlien   String?  @map("foto_klien")
  kawasanSlug String   @map("kawasan_slug")
  komentar    String   @db.Text
  komentarEn  String   @db.Text @map("komentar_en")
  rating      Int      @default(5)
  tanggal     DateTime @default(now())
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("testimoni")
}

// ── 6. Pengaturan Website & Profil ────────────────────────────
model SiteSetting {
  id        String   @id @default("global-setting")
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
